# Google Sheet for leads: see google-apps-script/SETUP.md
# The Apps Script web app URL (ends in /exec)
LEADS_WEBHOOK_URL=
# Any long random string; must match LEADS_SECRET in the Apps Script's Script Properties
LEADS_SECRET=

# Resend API key: https://resend.com/api-keys (optional once the Google Sheet is set up;
# without it, the Apps Script sends the emails from your Gmail instead)
RESEND_API_KEY=

# Sender address. onboarding@resend.dev only delivers to your own Resend account email;
# to email every attendee, verify your domain in Resend and use an address on it.
RESEND_FROM="Deep Trading <webinar@yourdomain.com>"

# Where new-signup notifications go (defaults to the contact email in site.ts)
REGISTRATION_NOTIFY_EMAIL=deepanshu29dy@gmail.com

# Your live site URL (used for WhatsApp/social link previews)
NEXT_PUBLIC_SITE_URL=https://www.thedeeptrading.in
